# ==============================================================================
# EVENTRA SERVER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to server/.env and fill in your local or production credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# CORS Allowed Frontend Origin(s)
FRONTEND_URL=http://localhost:5173

# MySQL Database Connection (Supports standard DB_* or Railway MySQL service variables)
# On Railway: map to ${{MySQL.MYSQLHOST}}, ${{MySQL.MYSQLPORT}}, etc.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=eventra_db
DB_SSL=false

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_random_jwt_key_here
JWT_EXPIRES_IN=7d
