# ==============================================================================
# EVENTRA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your environment values.
# NEVER commit your actual .env file or real passwords to git.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=eventra_db
DB_SSL=false

# JWT Authentication Secret & Token Lifespan
JWT_SECRET=your_super_secret_random_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration (for client/.env)
VITE_API_URL=http://localhost:5000/api
