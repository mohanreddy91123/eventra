{
  "name": "eventra-workspace",
  "version": "1.0.0",
  "description": "Eventra - Production Full-Stack AI-Powered Campus Event Discovery and Management Platform",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
